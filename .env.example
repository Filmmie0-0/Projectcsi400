VITE_API_URL=http://localhost:3000/api

# ───── Backend (Docker: npm run stack:up) ─────
# frontend เรียก gateway ที่ VITE_API_URL ด้านบน แล้ว gateway ส่งต่อไปแต่ละ service
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=dev-secret-change-me
DB_PORT=3306
PHPMYADMIN_PORT=8081
MYSQL_ROOT_PASSWORD=root
# database-per-service: user/database ของแต่ละ service (ใช้ตอนสร้าง DB ครั้งแรกเท่านั้น)
AUTH_DB_PASSWORD=auth_pass
JOB_DB_PASSWORD=job_pass
INVENTORY_DB_PASSWORD=inventory_pass
