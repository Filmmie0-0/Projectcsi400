# ───── Backend (Docker: npm run stack:up) ─────
# frontend เรียก gateway แล้ว gateway ส่งต่อไปแต่ละ service
GATEWAY_PORT=3000
# ต้องตรงกับ origin ของ frontend ทุกตัวอักษร (ใช้ทั้ง CORS และกัน CSRF)
CORS_ORIGIN=http://localhost:5173
# ค่าสุ่มอย่างน้อย 32 ไบต์ — สร้างใหม่ได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_JWT_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
# production: ตั้ง production + ใช้ HTTPS เพื่อเปิด Secure cookie
NODE_ENV=development
DB_PORT=3306
PHPMYADMIN_PORT=8081
MYSQL_ROOT_PASSWORD=root
# database-per-service: user/database ของแต่ละ service (ใช้ตอนสร้าง DB ครั้งแรกเท่านั้น)
AUTH_DB_PASSWORD=auth_pass
JOB_DB_PASSWORD=job_pass
INVENTORY_DB_PASSWORD=inventory_pass
