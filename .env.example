VITE_API_URL=http://localhost:3000/api
# true (ค่าเริ่มต้น) = ใช้ mock Web Service ในเบราว์เซอร์, false = ยิง backend จริง
VITE_USE_MOCK=true

# ───── Backend (Docker: npm run stack:up) ─────
# frontend เรียก gateway ที่ VITE_API_URL ด้านบน แล้ว gateway ส่งต่อไปแต่ละ service
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173
DB_PORT=3306
PHPMYADMIN_PORT=8081
MYSQL_ROOT_PASSWORD=root
# database-per-service: user/database ของแต่ละ service (ใช้ตอนสร้าง DB ครั้งแรกเท่านั้น)
AUTH_DB_PASSWORD=auth_pass
SPACE_DB_PASSWORD=space_pass
BOOKING_DB_PASSWORD=booking_pass
STORE_DB_PASSWORD=store_pass
